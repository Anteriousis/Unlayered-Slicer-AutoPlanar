; Define some macro setting for the gui
@CPACK_NSIS_INSTALLER_MUI_ICON_CODE@
@CPACK_NSIS_INSTALLER_ICON_CODE@
@CPACK_NSIS_INSTALLER_MUI_WELCOMEFINISH_CODE@
@CPACK_NSIS_INSTALLER_MUI_UNWELCOMEFINISH_CODE@
@CPACK_NSIS_INSTALLER_MUI_FINISHPAGE_RUN_CODE@

;--------------------------------
; Guards the destination chosen on the directory page. Only active in the
; per-user build, where the installer has no administrator rights.
;
; Deliberately an actual write attempt rather than a check of the path against
; a list of protected prefixes: prefix matching breaks on localised Windows,
; misses redirected or policy-controlled folders, and would wrongly reject a
; Program Files path on a machine where the user genuinely does have rights.
Function VerifyInstDirWritable
  StrCmp "@CPACK_NSIS_EXECUTION_LEVEL@" "user" 0 vidw_done

  CreateDirectory "$INSTDIR"
  ClearErrors
  FileOpen $0 "$INSTDIR\.unlayered-write-test" w
  IfErrors vidw_denied
  FileClose $0
  Delete "$INSTDIR\.unlayered-write-test"
  ; Removes the directory only if it is empty, so a folder created just for
  ; this test does not linger if the user goes back and picks another one.
  RMDir "$INSTDIR"
  Goto vidw_done

vidw_denied:
  MessageBox MB_OK|MB_ICONSTOP \
    "$INSTDIR cannot be written to.$\n$\nThis installer runs without administrator rights, so it can only install to a location you own -- for example $LOCALAPPDATA\Programs.$\n$\nTo install into Program Files for all users, use the system installer instead."
  Abort

vidw_done:
FunctionEnd

; Unlayered: optional Bambu Lab network plug-in. It is Bambu Lab's closed-source
; binary, so the installer never bundles or downloads it. A ticked box only
; records InstallBambuNetworkPlugin=1 under the app's registry key, and the
; slicer runs its own plug-in download (the same one as Preferences > Online)
; on its next launch. Unticked by default and an unticked box changes nothing,
; so a reinstall never removes a plug-in the user already has. Silent installs
; skip the page and so never opt in.
Function BambuPluginPage
  ${If} $UPDATE_MODE == "1"
    Abort
  ${EndIf}
  !insertmacro MUI_HEADER_TEXT "Bambu Lab printers" "Optional: printing to Bambu Lab printers"
  nsDialogs::Create 1018
  Pop $0
  ${If} $0 == error
    Abort
  ${EndIf}

  ${NSD_CreateLabel} 0 0 100% 72u "Sending prints to Bambu Lab printers, over your network or Bambu Cloud, needs Bambu Lab's network plug-in.$\r$\n$\r$\nThe plug-in is closed-source software from Bambu Lab. If you tick the box below, Unlayered Slicer downloads it from Bambu Lab's servers the first time it starts.$\r$\n$\r$\nYou can turn it on or off later in Preferences > Online."
  Pop $0

  ${NSD_CreateCheckbox} 0 80u 100% 12u "Install the Bambu Lab network plug-in"
  Pop $BAMBU_PLUGIN_CHECKBOX
  ${If} $BAMBU_PLUGIN_OPTIN == "1"
    ${NSD_Check} $BAMBU_PLUGIN_CHECKBOX
  ${EndIf}

  nsDialogs::Show
FunctionEnd

Function BambuPluginPageLeave
  ${NSD_GetState} $BAMBU_PLUGIN_CHECKBOX $0
  ${If} $0 == ${BST_CHECKED}
    StrCpy $BAMBU_PLUGIN_OPTIN "1"
  ${Else}
    StrCpy $BAMBU_PLUGIN_OPTIN "0"
  ${EndIf}
FunctionEnd


;--------------------------------
; Unlayered self-update progress. The slicer starts the installer as "/S /UPDATE ..." (silent),
; and a silent update showed nothing for the minute or two it takes to remove the old version and
; copy ~17,000 files. .onInit now switches an update back to a normal install that shows only a
; banner (while it waits for the slicer to close and removes the old version) and then the
; progress page, and closes itself when done. It is the NEW installer that runs, so this also
; applies to updates started by a slicer that predates it, which still passes /S.
Function SkipPageWhenUpdating
  ${If} $UPDATE_MODE == "1"
    Abort
  ${EndIf}
FunctionEnd

Function ShowProgressWhenUpdating
  ${If} $UPDATE_MODE == "1"
    SendMessage $HWNDPARENT ${WM_SETTEXT} 0 "STR:Updating Unlayered Slicer"
    !insertmacro MUI_HEADER_TEXT "Updating Unlayered Slicer" "Installing version ${VERSION}. Unlayered Slicer opens again by itself when this is done."
    ; Stopping half-way would leave no working copy at all.
    GetDlgItem $0 $HWNDPARENT 2
    EnableWindow $0 0
    BringToFront
  ${EndIf}
FunctionEnd

; The slicer starts the installer with SW_HIDE (it was a silent install), and Windows hands that to
; the first window shown; show it anyway.
Function UpdateGuiInit
  ${If} $UPDATE_MODE == "1"
    ShowWindow $HWNDPARENT ${SW_SHOW}
  ${EndIf}
FunctionEnd

Function ShowUpdateBanner
  ; $R0: the line under the title.
  Banner::destroy
  Banner::show /NOUNLOAD /set 76 "Updating Unlayered Slicer" "$R0"
FunctionEnd

