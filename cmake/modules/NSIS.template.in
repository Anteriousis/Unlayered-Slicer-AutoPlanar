  ; The user is free to change the install folder on this page. In the per-user
  ; build the installer is not elevated, so a protected destination such as
  ; Program Files cannot be written -- and because the process is manifested,
  ; Windows does not silently redirect it to VirtualStore either. Without this
  ; check the copy simply fails partway through with a generic error. Verify the
  ; choice is writable before committing to it.
  !define MUI_PAGE_CUSTOMFUNCTION_LEAVE VerifyInstDirWritable
  !define MUI_PAGE_CUSTOMFUNCTION_PRE SkipPageWhenUpdating
  !insertmacro MUI_PAGE_DIRECTORY

  ;Start Menu Folder Page Configuration
  !define MUI_STARTMENUPAGE_REGISTRY_ROOT "SHCTX"
