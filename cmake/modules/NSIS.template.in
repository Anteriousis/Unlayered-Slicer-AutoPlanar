  @CPACK_NSIS_INSTALLER_FINISH_TITLE_CODE@
  @CPACK_NSIS_INSTALLER_FINISH_TITLE_3LINES_CODE@
  !define MUI_PAGE_CUSTOMFUNCTION_PRE SkipPageWhenUpdating
  !insertmacro MUI_PAGE_FINISH

